[core]
	excludesfile = /Users/uedaryuichi/.gitignore_global
	autocrlf = false
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[user]
	name = RyuichiUeda
	email = hsatlefp@gmail.com
[commit]
	template = /Users/uedaryuichi/.stCommitMsg
[credential]
	helper = cache --timeout=3600
[init]
	defaultBranch = main
[includeIf "gitdir:~/universe_git/"]
	path = ~/.gitconfig_company
# [includeIf "gitdir:~/works/"]
# 	path = ~/.gitconfig_second
[pull]
	rebase = false
[alias]
	st = status
	co = checkout
	br = branch
	cm = commit
	df = diff
	gr = grep
	ps = push
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[push]
	default = current
